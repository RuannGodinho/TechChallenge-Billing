PORT=3002
DATABASE_URL=postgresql://billing:billing@localhost:5433/billing
INTERNAL_API_KEY=replace-with-long-random-secret
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=billing@example.com
ESTIMATE_EMAIL_TO=customer@example.com
POSTGRES_PASSWORD=change-me
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Original /api routes accept the JWT issued by Service Orders.
AUTH_MODE=local
JWT_SECRET=replace-with-the-Service-Orders-JWT-secret
# For AUTH_MODE=gateway, share the gateway trust secret.
GATEWAY_TRUST_SECRET=

# Local broker starts with this repository: docker compose up -d --build
# Keep these credentials when reusing an existing RabbitMQ volume.
RABBITMQ_URL=amqp://oficina:replace-with-local-password@rabbitmq:5672/oficina
RABBITMQ_USER=oficina
RABBITMQ_PASSWORD=replace-with-local-password
RABBITMQ_VHOST=oficina

# Docker Desktop default. On Linux, bind AMQP to an address reachable via host-gateway.
RABBITMQ_BIND_ADDRESS=127.0.0.1
