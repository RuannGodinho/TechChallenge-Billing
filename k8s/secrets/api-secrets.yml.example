apiVersion: v1
kind: Secret
metadata:
  name: billing-secrets
type: Opaque
stringData:
  DATABASE_URL: REPLACE_IN_GITHUB_SECRETS
  INTERNAL_API_KEY: REPLACE_IN_GITHUB_SECRETS
  GATEWAY_TRUST_SECRET: REPLACE_IN_GITHUB_SECRETS
  RABBITMQ_URL: REPLACE_IN_GITHUB_SECRETS
  SMTP_HOST: REPLACE_IN_GITHUB_SECRETS
  SMTP_PORT: REPLACE_IN_GITHUB_SECRETS
  SMTP_FROM: REPLACE_IN_GITHUB_SECRETS
  ESTIMATE_EMAIL_TO: REPLACE_IN_GITHUB_SECRETS
  JWT_SECRET: ''
  SMTP_USER: ''
  SMTP_PASS: ''
  MERCADO_PAGO_ACCESS_TOKEN: ''
  MERCADO_PAGO_WEBHOOK_SECRET: ''
